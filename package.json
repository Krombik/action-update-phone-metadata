{
  "name": "action-update-phone-metadata",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.ts'",
    "format-check": "prettier --check '**/*.ts'",
    "lint": "eslint .",
    "all": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm run check:print && pnpm run build",
    "check:print": "node --experimental-strip-types --no-warnings scripts/checkPrint.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krombik/action-update-phone-metadata.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "Andrii Dubetskyi",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "csv-parse": "^7.0.2",
    "fast-xml-parser": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.14.2",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "unrun": "^0.3.1"
  },
  "packageManager": "pnpm@11.5.2"
}
