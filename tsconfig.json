{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "lib": ["dom", "esnext"],
    "moduleResolution": "bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "noImplicitReturns": false,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "types": ["node"]
  },
  "include": ["src", "tsdown.config.ts"],
  "exclude": ["node_modules", "build", "example"]
}
